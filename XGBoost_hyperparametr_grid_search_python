"""
XGBoost hyperparameter grid search for AGB modelling from Sentinel-2 data.

The script loads a CSV table of AGB training samples, selects spectral, topographic
and forest-fraction predictors, and performs an exhaustive grid search over
key XGBoost hyperparameters (n_estimators, max_depth, learning_rate, gamma,
subsample, min_child_weight). Each parameter combination is evaluated using
5-fold cross-validation, and mean RMSE, MAE and R² are computed. The best
configurations are listed in a table and visualised in a bar plot.

The choice of tuned hyperparameters and the grid-search strategy follows
Tamiminia et al. (2022), who applied XGBoost to forest above-ground biomass
estimation using multi-sensor remote-sensing data.

Reference:
Tamiminia, H., Salehi, B., Mahdianpari, M., Beier, C., & Johnson, L. (2022):
Evaluating pixel-based and object-based approaches for forest above-ground
biomass estimation using a combination of optical, SAR, and an extreme gradient
boosting model. ISPRS Annals of the Photogrammetry, Remote Sensing and Spatial
Information Sciences, V-3-2022. 
https://isprs-annals.copernicus.org/articles/V-3-2022/485/2022/isprs-annals-V-3-2022-485-2022.pdf
"""

import pandas as pd
import numpy as np
import xgboost as xgb
from sklearn.model_selection import KFold
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
import itertools
import matplotlib.pyplot as plt

# 1) TRAINING DATA
df = pd.read_csv(
    r"C:\Users\lucip\Desktop\diplomová práce\forest_dynamic_HR\AGB_samples_S2_2018_frac.csv"
)

# Predictors selection
features = [
    'NDVI', 'MSI', 'NDVI705', 'elevation', 'slope',
    'broadleaf_share', 'conifer_share'
]
target = 'AGB'

# Remove rows with NaN in used columns
df = df.dropna(subset=features + [target])
X = df[features].astype(float)
y = df[target].astype(float)


# 2) PARAMETER GRID 

param_grid = {
    'n_estimators':      [100, 500, 1000],
    'max_depth':         [4, 6, 8],
    'learning_rate':     [0.05, 0.1],
    'gamma':             [0.0, 0.1, 0.3],
    'subsample':         [0.7, 0.9],
    'min_child_weight':  [1, 3, 5],
}

# All combinations of parameters
param_combinations = list(itertools.product(*param_grid.values()))
param_names = list(param_grid.keys())

print(f"Number of parameter combinations: {len(param_combinations)}")

# 3) K-FOLD CV SETUP 
results = []
kfold = KFold(n_splits=5, shuffle=True, random_state=42)

#  4) GRID SEARCH LOOP 
for i, values in enumerate(param_combinations):
    params = dict(zip(param_names, values))

    # XGBoost model with faster settings
    model = xgb.XGBRegressor(
        **params,
        random_state=42,
        verbosity=0,
        n_jobs=-1,          
        tree_method="hist"  
    )

    rmse_scores, mae_scores, r2_scores = [], [], []

    for train_idx, val_idx in kfold.split(X):
        X_train, X_val = X.iloc[train_idx], X.iloc[val_idx]
        y_train, y_val = y.iloc[train_idx], y.iloc[val_idx]

        model.fit(X_train, y_train)
        y_pred = model.predict(X_val)

        rmse_scores.append(np.sqrt(mean_squared_error(y_val, y_pred)))
        mae_scores.append(mean_absolute_error(y_val, y_pred))
        r2_scores.append(r2_score(y_val, y_pred))

    results.append({
        'Model_ID': f'M{i+1}',
        'RMSE': np.mean(rmse_scores),
        'MAE': np.mean(mae_scores),
        'R2': np.mean(r2_scores),
        **params
    })

# 5) RESULTS TABLE

results_df = pd.DataFrame(results).sort_values(by='R2', ascending=False)

print("TOP 10 models with parameters:")
print(results_df.head(10)[[
    'Model_ID', 'RMSE', 'MAE', 'R2',
    'n_estimators', 'max_depth', 'learning_rate',
    'gamma', 'subsample', 'min_child_weight'
]])

# 6) BAR PLOT FOR TOP 10

top = results_df.head(10)
labels = top['Model_ID']
x = np.arange(len(labels))
width = 0.25

fig, ax = plt.subplots(figsize=(12, 6))
ax.bar(x - width, top['RMSE'], width, label='RMSE')
ax.bar(x,         top['MAE'],  width, label='MAE', color="orange")
ax.bar(x + width, top['R2'],   width, label='R²',  color="green")
ax.set_xticks(x)
ax.set_xticklabels(labels)
ax.set_title("Comparison of XGBoost models (TOP 10)")
ax.set_ylabel("Score")
ax.legend()
plt.tight_layout()
plt.show()
