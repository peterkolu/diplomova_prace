/************************************************************
  PREDICTOR BUILDER FOR AGB MODELING (S2 + Landsat + DW/HR)
  ----------------------------------------------------------

  • Defines a study region (ROI) and projection at 100 m (EPSG:25833).
  • Builds cloud-free summer median composites for Sentinel-2 and Landsat:
      – Sentinel-2: S2_SR for 2018–2021, S2_SR_HARMONIZED for 2022–2024,
        cloud/shadow masking via SCL + S2 Cloud Probability < 40%.
        Computes NDVI, MSI, NDVI705; keeps key bands.
      – Landsat: LC08+LC09 L2, applies scale factors, masks with QA bits,
        computes NDVI and MSI.
  • Loads DEM (SRTM) and derives elevation and slope.
  • Loads annual forest fractions (asset: forest_100m_<year>_3bands) and
    builds forest mask plus shares (broadleaf, conifer). Works with flexible
    band naming (b1/b2/b3 or named bands).
  • Aggregates all predictors to 100 m using mean and reprojects to EPSG:25833.
  • Exports:
      – per-year GeoTIFF predictor stacks (S2 and LS variants) to Drive,
      – 2018 training CSV samples (S2 and LS) for model fitting.

  Inputs to check:
    ROI_ASSET               FeatureCollection used as region mask.
    YEARS                   Years to export.
    forestFracAssetId       Path template to the forest fractions per year.
    AGB2018_ID              Optional ESA AGB 2018 raster (not required for export).
    DRIVE_FOLDER            Google Drive folder for exports.

  Outputs:
    • GeoTIFFs: PredRasters_S2_<year>_100m_EPSG25833.tif
                 PredRasters_LS_<year>_100m_EPSG25833.tif
      Bands S2:  NDVI, MSI, NDVI705, elevation, slope, forest_frac, broadleaf_share, conifer_share
      Bands LS:  NDVI, MSI, elevation, slope, forest_frac, broadleaf_share, conifer_share
    • CSVs (2018): PredSamples_S2_2018_100m_EPSG25833.csv
                   PredSamples_LS_2018_100m_EPSG25833.csv
************************************************************/

// PARAMETERS
var ROI_ASSET    = 'projects/tidy-forest-404511/assets/hranice_cr';
var YEARS        = [2018, 2019, 2020, 2021, 2022, 2023, 2024];
var CRS          = 'EPSG:25833';
var SCALE100     = 100;
var proj100      = ee.Projection(CRS).atScale(SCALE100);
var DRIVE_FOLDER = 'GEE';

var AGB2018_ID   = 'projects/tidy-forest-404511/assets/ESA_AGB_2018_UTM';
var AGB_BAND     = 'b1';

// Annual forest fractions: 3 bands (b1=coniferous_fraction, b2=deciduous_fraction, b3=forest_mask)
function forestFracAssetId(year){
  return 'projects/tidy-forest-404511/assets/forest_100m_' + year + '_3bands';
}

// ROI
var regionGeom = ee.FeatureCollection(ROI_ASSET).geometry();

// DEM 
var dem = ee.Image('USGS/SRTMGL1_003')
  .clip(regionGeom)
  .setDefaultProjection(CRS, null, 30);

var elevation = dem.rename('elevation');
var slope     = ee.Terrain.slope(dem).rename('slope').setDefaultProjection(CRS, null, 30);

// Sentinel-2
// Original L2A
var S2SR   = ee.ImageCollection('COPERNICUS/S2_SR');
// Harmonized L2A (removes PB 04/05 discontinuity)
var S2SR_H = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED');
// Cloud probability collection
var S2PROB = ee.ImageCollection('COPERNICUS/S2_CLOUD_PROBABILITY');

// Choose collection by year (2018–2021 = S2_SR, 2022–2024 = S2_SR_HARMONIZED)
function s2IC(year) {
  return (year >= 2022) ? S2SR_H : S2SR;
}

function seasonStart(y){ return ee.Date.fromYMD(y, 6, 1); }   // June 1
function seasonEnd(y){   return ee.Date.fromYMD(y, 9, 30); }  // Sep 30

// Join S2 with cloud probability by system:index
function joinS2WithCloudProb(ic) {
  var joined = ee.Join.saveFirst('cloudprob').apply({
    primary: ic,
    secondary: S2PROB,
    condition: ee.Filter.equals({leftField:'system:index', rightField:'system:index'})
  });
  return ee.ImageCollection(joined.map(function(img) {
    var cp = ee.Image(ee.Algorithms.If(
      img.get('cloudprob'),
      ee.Image(img.get('cloudprob')).select('probability'),
      ee.Image(0).rename('probability').toUint8()
    ));
    return ee.Image(img).addBands(cp.rename('CLOUD_PROB'));
  }));
}

// Mask clouds and shadows using SCL and cloud probability
function maskS2_ensemble(image) {
  var scl = image.select('SCL');
  var goodSCL = scl.neq(3).and(scl.neq(7)).and(scl.neq(8))
                   .and(scl.neq(9)).and(scl.neq(10)).and(scl.neq(11));
  var goodProb = image.select('CLOUD_PROB').lt(40);
  return image.updateMask(goodSCL.and(goodProb));
}

// Add S2 indices at native scales (10/20 m), keep key bands
function addS2Indices_native(image) {
  var img = image.setDefaultProjection(CRS, null, 10);
  var swir20 = img.select('B11').setDefaultProjection(CRS, null, 20);
  var nir20  = img.select('B8').resample('bilinear').reproject({crs: CRS, scale: 20});
  var ndvi    = img.normalizedDifference(['B8','B4']).rename('NDVI').setDefaultProjection(CRS, null, 10);
  var msi20   = swir20.divide(nir20).rename('MSI').setDefaultProjection(CRS, null, 20);
  var ndvi705 = img.normalizedDifference(['B7','B5']).rename('NDVI705').setDefaultProjection(CRS, null, 20);
  return img.addBands([ndvi, msi20, ndvi705], null, true);
}

// Build summer median S2 composite, masked and clipped
function makeS2Composite(year){
  return joinS2WithCloudProb(
      s2IC(year) // switch SR vs SR_HARMONIZED here
        .filterDate(seasonStart(year), seasonEnd(year))
        .filterBounds(regionGeom)
        .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 60))
    )
    .map(maskS2_ensemble)
    .map(function(img){ return img.select(['B2','B3','B4','B5','B7','B8','B11','SCL','CLOUD_PROB']); })
    .map(addS2Indices_native)
    .median()
    .clip(regionGeom)
    .setDefaultProjection(CRS, null, 10);
}

//Landsat 
// Apply L2 scale factors to optical SR bands
function applyScaleFactors(image) {
  var optical = image.select('SR_B.*').multiply(0.0000275).add(-0.2);
  return image.addBands(optical, null, true);
}

// Mask clouds, shadows, snow, etc. via QA bits and saturation
function maskLandsatQA(image) {
  var qa = image.select('QA_PIXEL');
  var good = qa.bitwiseAnd(1).eq(0)
    .and(qa.bitwiseAnd(2).eq(0))
    .and(qa.bitwiseAnd(4).eq(0))
    .and(qa.bitwiseAnd(8).eq(0))
    .and(qa.bitwiseAnd(16).eq(0))
    .and(qa.bitwiseAnd(32).eq(0));
  var sat = image.select('QA_RADSAT').eq(0);
  return image.updateMask(good).updateMask(sat);
}

// Add Landsat NDVI and MSI
function addLsIndices(img) {
  var ndvi = img.normalizedDifference(['SR_B5','SR_B4']).rename('NDVI');
  var msi  = img.select('SR_B6').divide(img.select('SR_B5')).rename('MSI');
  return img.addBands([ndvi, msi]);
}

// Build summer median Landsat composite (L8+L9)
function makeLandsatComposite(year){
  var l8 = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2');
  var l9 = ee.ImageCollection('LANDSAT/LC09/C02/T1_L2');
  return l8.merge(l9)
    .filterDate(seasonStart(year), seasonEnd(year))
    .filterBounds(regionGeom)
    .map(applyScaleFactors)
    .map(maskLandsatQA)
    .map(addLsIndices)
    .select(['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7','NDVI','MSI'])
    .median()
    .clip(regionGeom)
    .setDefaultProjection(CRS, null, 30);
}

//Aggregation to 100 m 
// Mean aggregation to 100 m, then reproject
function aggTo100m(imgBand, nativeScale) {
  var withProj = imgBand.setDefaultProjection(CRS, null, nativeScale);
  var reduced  = withProj.reduceResolution({ reducer: ee.Reducer.mean(), maxPixels: 4096 });
  return reduced.reproject(proj100);
}

// Forest fractions (b1/b2/b3)
// Load 3-band forest fractions, normalize band names, derive mask
function getForestFracs(year){
  var raw   = ee.Image(forestFracAssetId(year)).clip(regionGeom).reproject(proj100);
  var names = raw.bandNames();

  var conifName = ee.String(ee.Algorithms.If(
    names.indexOf('coniferous_fraction').neq(-1), 'coniferous_fraction',
    ee.Algorithms.If(names.indexOf('coniferous').neq(-1), 'coniferous', 'b1')
  ));
  var decidName = ee.String(ee.Algorithms.If(
    names.indexOf('deciduous_fraction').neq(-1), 'deciduous_fraction',
    ee.Algorithms.If(names.indexOf('deciduous').neq(-1), 'deciduous', 'b2')
  ));
  var maskName  = ee.String(ee.Algorithms.If(
    names.indexOf('forest_mask').neq(-1), 'forest_mask', 'b3'
  ));

  var conif = raw.select(conifName).toFloat();   // 0–1
  var decid = raw.select(decidName).toFloat();   // 0–1
  var maskF = raw.select(maskName).toFloat();    // ~0/1

  var forestFrac = conif.add(decid).clamp(0, 1).rename('forest_frac');
  var broadleaf  = decid.rename('broadleaf_share');
  var conifer    = conif.rename('conifer_share');
  var mask       = maskF.gte(0.5).toByte().rename('forest_mask100');

  var three = ee.Image.cat([forestFrac, broadleaf, conifer]).toFloat().reproject(proj100);
  return { img: three, mask: mask.reproject(proj100) };
}

// Predictors 
// Build Sentinel-2 predictor stack at 100 m, masked to forest
function buildS2Pred(year, fracs){
  var s2 = makeS2Composite(year);
  return ee.Image.cat([
      aggTo100m(s2.select('NDVI'),    10),
      aggTo100m(s2.select('MSI'),     20),
      aggTo100m(s2.select('NDVI705'), 20),
      aggTo100m(elevation,            30),
      aggTo100m(slope,                30),
      fracs.img
    ])
    .toFloat()
    .rename(['NDVI','MSI','NDVI705','elevation','slope',
             'forest_frac','broadleaf_share','conifer_share'])
    .reproject(proj100)
    .updateMask(fracs.mask);
}

// Build Landsat predictor stack at 100 m, masked to forest
function buildLSPred(year, fracs){
  var ls = makeLandsatComposite(year);
  return ee.Image.cat([
      aggTo100m(ls.select('NDVI'), 30),
      aggTo100m(ls.select('MSI'),  30),
      aggTo100m(elevation,         30),
      aggTo100m(slope,             30),
      fracs.img
    ])
    .toFloat()
    .rename(['NDVI','MSI','elevation','slope',
             'forest_frac','broadleaf_share','conifer_share'])
    .reproject(proj100)
    .updateMask(fracs.mask);
}

//AGB 2018 (training) 

var agb2018 = ee.Image(AGB2018_ID).select(AGB_BAND)
                .rename('AGB')
                .reproject(proj100)
                .clip(regionGeom);

//Export setting 
function exportPredictorRaster(img, year, tag){
  var taskName = 'PredRasters_' + tag + '_' + year + '_100m_EPSG25833';
  Export.image.toDrive({
    image: img.toFloat(),
    description: taskName,
    folder: DRIVE_FOLDER,
    fileNamePrefix: taskName,
    region: regionGeom,
    crs: CRS,
    scale: SCALE100,
    maxPixels: 1e13,
    fileFormat: 'GeoTIFF'
  });
}

function exportPredictorCSV(img, year, tag, selectors){
  var samples = img.sample({
    region: regionGeom,
    projection: proj100,
    scale: SCALE100,
    numPixels: 50000,
    seed: year * 17,
    tileScale: 4,
    geometries: false
  }).filter(ee.Filter.notNull(selectors));

  Export.table.toDrive({
    collection: samples,
    description: 'PredSamples_' + tag + '_' + year + '_100m_EPSG25833',
    folder: DRIVE_FOLDER,
    fileNamePrefix: 'PredSamples_' + tag + '_' + year + '_100m_EPSG25833',
    fileFormat: 'CSV',
    selectors: selectors
  });
}

// Export tables (2018)
(function exportTraining2018(){
  var fr2018     = getForestFracs(2018);
  var s2Pred2018 = buildS2Pred(2018, fr2018);
  var lsPred2018 = buildLSPred(2018, fr2018);

  print('S2 bands (2018):', s2Pred2018.bandNames());
  print('LS bands (2018):', lsPred2018.bandNames());

  var S2_SELECTORS = ['NDVI','MSI','NDVI705','elevation','slope',
                      'forest_frac','broadleaf_share','conifer_share'];
  var LS_SELECTORS = ['NDVI','MSI','elevation','slope',
                      'forest_frac','broadleaf_share','conifer_share'];

  exportPredictorCSV(s2Pred2018, 2018, 'S2', S2_SELECTORS);
  exportPredictorCSV(lsPred2018, 2018, 'LS', LS_SELECTORS);
})();

// Export rasters: all years
YEARS.forEach(function(y){
  var fr  = getForestFracs(y);
  var s2p = buildS2Pred(y, fr); // from 2022 uses S2_SR_HARMONIZED automatically
  var lsp = buildLSPred(y, fr);

  exportPredictorRaster(s2p, y, 'S2');
  exportPredictorRaster(lsp, y, 'LS');
});
