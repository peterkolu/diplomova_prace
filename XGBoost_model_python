# -*- coding: utf-8 -*-
"""
This script trains an XGBoost regression model to predict above-ground biomass (AGB)
from remote sensing and terrain predictors. It loads a training CSV, selects the
feature set based on the chosen mode (Sentinel-2 or Landsat), performs 5-fold
cross-validation and a hold-out test, saves the fitted model, and produces basic
feature importance and SHAP plots. Finally, it applies the trained model to yearly
predictor GeoTIFF stacks and writes AGB prediction rasters at 100 m resolution.

Inputs:
  1) A CSV with columns: AGB and the selected predictors.
  2) A base folder with yearly GeoTIFF predictor stacks (100 m, EPSG:25833).
  3) Mode flag: "S2" expects NDVI705, "LS" does not.
  4) List of years to export prediction maps.

Outputs:
  1) Trained model saved as joblib.
  2) CV and hold-out metrics printed to console.
  3) Optional feature importance and SHAP plots.
  4) A GeoTIFF AGB map per year written to the base folder.
"""

import os
import numpy as np
import pandas as pd
import xgboost as xgb
from sklearn.model_selection import KFold, train_test_split
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
import matplotlib.pyplot as plt
import shap
import rasterio
from joblib import dump

#  INPUTS 

# Training table. Columns must include AGB and predictors for the chosen MODE.
CSV_PATH = r"C:\Users\lucip\Desktop\diplomová práce\forest_dynamic_HR\AGB_samples_S2_2018_frac.csv"

# Prediction mode. Use 'S2' when NDVI705 is available, otherwise use 'LS'.
MODE = 'S2'   # or 'LS'

# Base folder containing predictor rasters to be scored.
BASE_DIR = r"C:\Users\lucip\Desktop\diplomová práce\forest_dynamic_HR"

# Years to produce prediction maps for.
YEARS = [2018, 2019, 2020, 2021, 2022, 2023, 2024]

# FEATURES 

if MODE == 'S2':
    FEATURES = ['NDVI', 'MSI', 'NDVI705', 'elevation', 'slope',
                'broadleaf_share', 'conifer_share']
else:
    FEATURES = ['NDVI', 'MSI', 'elevation', 'slope',
                'broadleaf_share', 'conifer_share']

TARGET = 'AGB'
print(f"Mode: {MODE} | FEATURES: {FEATURES}")

# DATA 

# Read CSV and normalize column names
df = pd.read_csv(CSV_PATH)
df.columns = df.columns.str.strip()

# Check that all required columns exist
missing = [c for c in (FEATURES + [TARGET]) if c not in df.columns]
if missing:
    raise ValueError(
        f"Missing columns in CSV: {missing}\n"
        f"Available columns: {list(df.columns)}"
    )

# Drop NaNs only in used columns
df = df.dropna(subset=FEATURES + [TARGET]).copy()

X = df[FEATURES].astype(float)
y = df[TARGET].astype(float)

print("Data shape:", X.shape, "(n_samples, n_features)")
print("Columns:", list(X.columns))

# MODEL 

print("XGBoost version:", xgb.__version__)

MODEL_PARAMS = dict(
    n_estimators=1000,
    learning_rate=0.05,
    max_depth=6,
    subsample=0.8,
    colsample_bytree=0.8,
    reg_lambda=1.0,
    objective='reg:squarederror',
    n_jobs=-1,
    eval_metric='rmse',
    tree_method='hist',
    random_state=42
)

def fit_xgb_version_safe(est, X_tr, y_tr, X_va=None, y_va=None):
    """Fit with early stopping where supported by the installed XGBoost."""
    if X_va is not None and y_va is not None:
        try:
            return est.fit(
                X_tr, y_tr,
                eval_set=[(X_va, y_va)],
                verbose=False,
                callbacks=[xgb.callback.EarlyStopping(rounds=50, save_best=True)]
            )
        except TypeError:
            try:
                return est.fit(
                    X_tr, y_tr,
                    eval_set=[(X_va, y_va)],
                    eval_metric='rmse',
                    early_stopping_rounds=50,
                    verbose=False
                )
            except TypeError:
                return est.fit(X_tr, y_tr, verbose=False)
    else:
        return est.fit(X_tr, y_tr, verbose=False)

# 5-FOLD CV 

kf = KFold(n_splits=5, shuffle=True, random_state=42)
rmse_cv, mae_cv, r2_cv = [], [], []

for tr_idx, va_idx in kf.split(X):
    X_tr, X_va = X.iloc[tr_idx], X.iloc[va_idx]
    y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]

    m = xgb.XGBRegressor(**MODEL_PARAMS)
    fit_xgb_version_safe(m, X_tr, y_tr, X_va, y_va)

    pred_va = m.predict(X_va)
    rmse_cv.append(np.sqrt(mean_squared_error(y_va, pred_va)))
    mae_cv.append(mean_absolute_error(y_va, pred_va))
    r2_cv.append(r2_score(y_va, pred_va))

print("\n5-fold CV:")
print(f"  RMSE: {np.mean(rmse_cv):.2f} ± {np.std(rmse_cv):.2f}")
print(f"  MAE : {np.mean(mae_cv):.2f} ± {np.std(mae_cv):.2f}")
print(f"  R²  : {np.mean(r2_cv):.3f} ± {np.std(r2_cv):.3f}")

# HOLD-OUT 

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42
)

model = xgb.XGBRegressor(**MODEL_PARAMS)
fit_xgb_version_safe(model, X_train, y_train, X_test, y_test)

y_pred = model.predict(X_test)
rmse = np.sqrt(mean_squared_error(y_test, y_pred))
mae  = mean_absolute_error(y_test, y_pred)
r2   = r2_score(y_test, y_pred)
me   = float(np.mean(y_pred - y_test))

print("\nHold-out test:")
print(f"  RMSE: {rmse:.2f}")
print(f"  MAE : {mae:.2f}")
print(f"  R²  : {r2:.3f}")
print(f"  ME  : {me:.2f}")

# Save fitted model
dump(model, f"xgb_agb_{MODE.lower()}_100m.joblib")

# SHAP AND FEATURE IMPORTANCE (optional) 

booster = model.get_booster()
booster.feature_names = list(X.columns)
xgb.plot_importance(booster=booster, importance_type='gain', show_values=False)
plt.title("Feature Importance (XGBoost, gain)")
plt.tight_layout(); plt.show()

X_shap = X_test.copy()
if len(X_shap) > 5000:
    X_shap = X_shap.sample(5000, random_state=42)

try:
    explainer = shap.TreeExplainer(model)
    sv = explainer(X_shap)
    shap_values_array = sv.values if hasattr(sv, "values") else np.array(sv)
except Exception:
    explainer = shap.TreeExplainer(model)
    shap_values_array = explainer.shap_values(X_shap)

shap.summary_plot(shap_values_array, X_shap, plot_type="bar")
shap.summary_plot(shap_values_array, X_shap)

X_dep = X_shap.copy()
vals = shap_values_array  # shape (n_samples, n_features)

feat_names = list(X_dep.columns)
n = len(feat_names)
n_cols = 3
n_rows = int(np.ceil(n / n_cols)) if n > 0 else 1

fig, axes = plt.subplots(n_rows, n_cols, figsize=(5*n_cols, 4*n_rows))
axes = np.array(axes).reshape(-1)

for i, f in enumerate(feat_names):
    j = X_dep.columns.get_loc(f)
    ax = axes[i]
    ax.scatter(
        X_dep.iloc[:, j].values,
        vals[:, j],
        s=20, alpha=0.6,
        c=X_dep.iloc[:, j].values, cmap='coolwarm'
    )
    ax.axhline(0, color='gray', ls='--', lw=1)
    ax.set_xlabel(f); ax.set_ylabel("SHAP value"); ax.set_title(f)

# Remove empty panels
for k in range(i+1, len(axes)):
    fig.delaxes(axes[k])

fig.tight_layout()
plt.show()

# PREDICTION RASTERS 

def candidates_for_year(y, mode):
    """Return possible file names for the yearly predictor stack. First existing is used."""
    if mode == 'S2':
        return [
            fr"{BASE_DIR}\PredRasters_S2_{y}_100m_EPSG25833.tif",
        ]
    else:
        return [
            fr"{BASE_DIR}\PredRasters_LS_{y}_100m_EPSG25833.tif",
        ]

def choose_tif_paths(years, mode):
    """Locate the GeoTIFF for each year based on expected names."""
    paths = {}
    for y in years:
        found = None
        for p in candidates_for_year(y, mode):
            if os.path.exists(p):
                found = p
                break
        if not found:
            raise FileNotFoundError(
                f"No predictor TIFF found for year {y} in {BASE_DIR}. "
                f"Check file names and folder."
            )
        paths[y] = found
    return paths

TIF_PATHS = choose_tif_paths(YEARS, MODE)

def select_band_indexes(band_count, mode):
    """
    Return 1-based band indexes to read the requested FEATURES from a TIFF.
    S2 expects 7 bands: NDVI, MSI, NDVI705, elevation, slope, broadleaf_share, conifer_share.
    If there are 8 bands, skip band 6 named forest_frac and read [1,2,3,4,5,7,8].
    LS expects 6 bands: NDVI, MSI, elevation, slope, broadleaf_share, conifer_share.
    If there are 7 bands, skip band 5 named forest_frac and read [1,2,3,4,6,7].
    """
    if mode == 'S2':
        if band_count == 7:
            return [1, 2, 3, 4, 5, 6, 7]
        elif band_count == 8:
            return [1, 2, 3, 4, 5, 7, 8]
    else:
        if band_count == 6:
            return [1, 2, 3, 4, 5, 6]
        elif band_count == 7:
            return [1, 2, 3, 4, 6, 7]
    raise ValueError(f"Unexpected band count {band_count} for mode {mode}.")

def create_agb_map(tif_path, year, mode, expected_feature_list):
    """Apply the trained model to a predictor stack and write a single-band AGB GeoTIFF."""
    with rasterio.open(tif_path) as src:
        bands_total = src.count
        idx = select_band_indexes(bands_total, mode)
        stack = src.read(indexes=idx)   # shape: (bands_needed, rows, cols)
        profile = src.profile
        nodata = src.nodata

    if stack.shape[0] != len(expected_feature_list):
        raise ValueError(
            f"TIFF for year {year} has {stack.shape[0]} selected bands "
            f"but {len(expected_feature_list)} are expected: {expected_feature_list}."
        )

    bands, rows, cols = stack.shape
    reshaped = stack.reshape(bands, -1).T.astype(np.float32)  # shape: (n_pix, n_feat)

    valid = np.ones(reshaped.shape[0], dtype=bool)
    if nodata is not None:
        valid &= ~(np.isclose(reshaped, nodata)).any(axis=1)
    valid &= ~np.isnan(reshaped).any(axis=1)

    preds = np.full((reshaped.shape[0],), np.nan, dtype=np.float32)
    if valid.any():
        preds[valid] = model.predict(reshaped[valid])

    agb_map = preds.reshape(rows, cols)

    profile.update(dtype=rasterio.float32, count=1, compress='lzw', nodata=np.nan)
    out_path = rf"{BASE_DIR}\AGB_{mode}_prediction_{year}.tif"
    with rasterio.open(out_path, "w", **profile) as dst:
        dst.write(agb_map, 1)
    print(f"Saved map for year {year}: {out_path}")

# Expected band names in the same order as FEATURES
EXPECTED_BANDS = FEATURES.copy()

for yr in YEARS:
    create_agb_map(TIF_PATHS[yr], yr, MODE, EXPECTED_BANDS)
