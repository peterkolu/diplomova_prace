//VSTUPY

var region = ee.FeatureCollection('projects/tidy-forest-404511/assets/hranice_cr');

//AGB predikce (100 m, EPSG:25833)
var agbPred2019 = ee.Image('projects/tidy-forest-404511/assets/AGB_predic_S2_2019')
  .rename('AGB_pred').reproject({crs: 'EPSG:25833', scale: 100}).clip(region);
var agbPred2020 = ee.Image('projects/tidy-forest-404511/assets/AGB_predic_S2_2020')
  .rename('AGB_pred').reproject({crs: 'EPSG:25833', scale: 100}).clip(region);
var agbPred2021 = ee.Image('projects/tidy-forest-404511/assets/AGB_predic_S2_2021')
  .rename('AGB_pred').reproject({crs: 'EPSG:25833', scale: 100}).clip(region);

// CLC 2018 – maska lesů + "core forest" (odstranění okrajů o 50 m)
var clc2018 = ee.Image('COPERNICUS/CORINE/V20/100m/2018')
  .select('landcover').reproject({crs: 'EPSG:25833', scale: 100}).clip(region);

var forestMask2018 = clc2018.eq(311).or(clc2018.eq(312)).or(clc2018.eq(313)).rename('forest');
var forestCore = forestMask2018.focal_min({radius: 50, units: 'meters'}).rename('forest_core');

/******************* 1) GEDI DATASETS ****************************************/
// L4B – gridded 1 km mean biomass (2019–2021)
var gediL4B = ee.Image('LARSE/GEDI/GEDI04_B_002'); // 1 km EASE2 grid
var l4bProj = gediL4B.select('MU').projection();

// L4A MONTHLY – rasterizované footprinty (~25 m), 2019–2021
var gediL4A_monthly = ee.ImageCollection('LARSE/GEDI/GEDI04_A_002_MONTHLY');

/******************* 2) FUNKCE: AGB_pred → 1 km grid GEDI *********************/
var proj100 = ee.Projection('EPSG:25833').atScale(100);

function to1kmLikeL4B(img100) {
  var img = img100.setDefaultProjection('EPSG:25833', null, 100).reproject(proj100);
  var reduced = img.reduceResolution({reducer: ee.Reducer.mean(), maxPixels: 16384});
  return reduced.reproject(l4bProj);
}

// 1km podíl lesa (CLC2018) – pro filtrování buněk
var forestFrac1km = forestMask2018
  .setDefaultProjection('EPSG:25833', null, 100).reproject(proj100)
  .reduceResolution({reducer: ee.Reducer.mean(), maxPixels: 16384})
  .reproject(l4bProj).rename('forest_frac');

// Validace jen tam, kde ≥50 % buňky pokrývá les
var forestMask1km = forestFrac1km.gt(0.5);

//METRIKY VALIDACE
function computeMetrics(fc, yRef, yPred) {
  var withErr = fc.map(function(f){
    var ref = ee.Number(f.get(yRef));
    var pred = ee.Number(f.get(yPred));
    var err = pred.subtract(ref);
    return f.set({
      'err': err,
      'abs_err': err.abs(),
      'sq_err': err.pow(2)
    });
  });
  var mae = ee.Number(withErr.aggregate_mean('abs_err'));
  var mse = ee.Number(withErr.aggregate_mean('sq_err'));
  var rmse = mse.sqrt();
  var bias = ee.Number(withErr.aggregate_mean('err'));
  var corr = withErr.reduceColumns(ee.Reducer.pearsonsCorrelation(), [yPred, yRef])
    .get('correlation');
  var r2 = ee.Number(corr).pow(2);
  var n = withErr.size();
  return ee.Dictionary({'n': n, 'RMSE': rmse, 'MAE': mae, 'Bias': bias, 'R2': r2});
}

//VALIDACE L4B PRO JEDNOTLIVÉ ROKY
// Helper funkce pro validaci L4B
function validateL4B(agbPred, yearTag) {
  var agbPred1km = to1kmLikeL4B(agbPred).rename('AGB_pred_1km');
  var l4b_good = gediL4B.updateMask(gediL4B.select('QF').eq(2));

  var pairs = l4b_good.select(['MU','SE'])
    .rename(['AGBD_GEDI','SE_GEDI'])
    .updateMask(forestMask1km)
    .addBands(agbPred1km)
    .sample({
      region: region.geometry(),
      scale: 1000,
      projection: l4bProj,
      geometries: false,
      tileScale: 4
    });

  print('L4B grid validation – stats ' + yearTag, computeMetrics(pairs, 'AGBD_GEDI', 'AGB_pred_1km'));
  return pairs;
}

// Spuštění pro roky 2019–2021
var pairs2019 = validateL4B(agbPred2019, '2019');
var pairs2020 = validateL4B(agbPred2020, '2020');
var pairs2021 = validateL4B(agbPred2021, '2021');


// VALIDACE L4A – (náhodný vzorek foodprintů)
var doL4A = true;
if (doL4A) {
  //parametry vzorkování
  var years = [2019, 2020, 2021];
  var numSamples = 10000;     // kolik footprintů náhodně vzít pro každý rok
  var bufferR = 50;           // vyhlazení modelu (m) kvůli footprint vs. pixel posunu
  var seedBase = 12345;       // pro opakovatelnost

  // L4A kolekce + masky kvality
  var gediL4A_monthly = ee.ImageCollection('LARSE/GEDI/GEDI04_A_002_MONTHLY');
  var qualityMask = function(im) {
    return im.updateMask(im.select('l4_quality_flag').eq(1))
             .updateMask(im.select('degrade_flag').eq(0));
  };

  // Pomocná funkce: vratí odpovídající AGB predikci pro rok
  function pickAgbPred(year) {
    return ee.Image(ee.Dictionary({
      2019: agbPred2019,
      2020: agbPred2020,
      2021: agbPred2021
    }).get(year.toString()));
  }

  // Funkce: validace jednoho roku s náhodným vzorkem footprintů
  function validateL4A_year(year, nSamples, seed) {
    // 1) L4A rastr – průměr přes měsíce daného roku, kvalita + maska CLC2018 (les)
    var l4a_year = gediL4A_monthly
      .filterDate(ee.Date.fromYMD(year,1,1), ee.Date.fromYMD(year,12,31))
      .map(qualityMask)
      .select(['agbd', 'agbd_se'])
      .map(function(im){
        // omezíme na lesy CLC 2018
        return im.updateMask(forestMask2018.reproject({crs: im.projection(), scale: 25}));
      })
      .mean()
      .rename(['AGBD_GEDI25','SE_GEDI25'])
      .clip(region);

    // 2) Model AGB pro stejný rok, vyhlazený v bufferu
    var agb_pred = pickAgbPred(year).focal_mean({radius: bufferR, units: 'meters'})
                    .rename('AGB_pred_100m');

    // 3) Stack a náhodné vzorkování footprintů (numPixels = nSamples)
    var stack = l4a_year.addBands(agb_pred);
    var pairs = stack.sample({
      region: region.geometry(),
      scale: 25,                 // rozlišení L4A
      numPixels: nSamples,       // náhodný vzorek
      seed: seed,
      geometries: false,
      tileScale: 4
    }).filter(ee.Filter.notNull(['AGBD_GEDI25','AGB_pred_100m']));

    // 4) Metriky
    var stats = computeMetrics(pairs, 'AGBD_GEDI25', 'AGB_pred_100m');
    print('L4A footprint validation – stats (' + year + ') [n=' + nSamples + ']', stats);

    // 5) scatter pro daný rok (rychlý)
    var chart = ui.Chart.feature.byFeature(pairs, 'AGB_pred_100m', ['AGBD_GEDI25'])
      .setChartType('ScatterChart')
      .setOptions({
        title: 'Model vs. GEDI L4A (' + year + ') – náhodný vzorek ' + nSamples,
        hAxis: {title: 'AGB model [Mg/ha]'},
        vAxis: {title: 'GEDI L4A [Mg/ha]'},
        pointSize: 2,
        trendlines: {0: {showR2: true, visibleInLegend: true}}
      });
    print(chart);

    // 6) Export
    Export.table.toDrive({
      collection: pairs,
      description: 'validation_pairs_GEDI_L4A_sample_' + year + '_n' + nSamples,
      fileFormat: 'CSV'
    });
  }

  // Spuštění pro všechny roky
  years.forEach(function(y, i){
    validateL4A_year(y, numSamples, seedBase + i);
  });
}


